# ============================================
# ERCMed - Environment Variables
# ============================================
# IMPORTANT: This file is NOT committed to Git.
# Copy this file to .env and fill in the actual values.
# For CI/CD (GitHub Actions, etc.), add these as Repository Secrets.
# ============================================

# ---- Firebase Config ----
# Found at: Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ---- Google Gemini API ----
# Found at: https://aistudio.google.com/app/apikey
VITE_GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# ---- Groq API (Clinical AI Summaries) ----
# Found at: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY_ALT=your_groq_api_key_alt_here

# ---- Firebase App Check (reCAPTCHA Enterprise) ----
# Public site key used to verify requests made by the web app.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your_recaptcha_enterprise_site_key_here

# ---- Mercado Pago Checkout ----
# Create one recurring checkout link per paid plan in Mercado Pago and paste it here.
# These are public checkout URLs; never place Mercado Pago access tokens in this file.
VITE_MERCADO_PAGO_PROFESSIONAL_URL=https://www.mercadopago.com.br/subscriptions/checkout?preapproval_plan_id=your_professional_plan_id
VITE_MERCADO_PAGO_ADVANCED_URL=https://www.mercadopago.com.br/subscriptions/checkout?preapproval_plan_id=your_advanced_plan_id
VITE_MERCADO_PAGO_ENTERPRISE_URL=https://www.mercadopago.com.br/subscriptions/checkout?preapproval_plan_id=your_enterprise_plan_id
