rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // HELPER FUNCTIONS
    // =============================================

    // Is the request from a logged-in user?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Is the requester the master admin?
    function isMasterAdmin() {
      return isAuthenticated() &&
             request.auth.token.email == 'elsoncontador.st@gmail.com';
    }

    // Is the requester the owner of a given userId?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Is the requester a member of the clinic (has managerId matching the owner)?
    function isClinicMember(managerId) {
      return isAuthenticated() && (
        request.auth.uid == managerId ||
        (exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.get('managerId', '') == managerId) ||
        (exists(/databases/$(database)/documents/system_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data.get('managerId', '') == managerId)
      );
    }

    function isClinicManager() {
      let profile = get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data;
      return isAuthenticated() && (
        profile.get('isClinicManager', false) == true ||
        profile.get('role', 'user') in ['admin', 'manager', 'admin_gestor', 'admin_master']
      );
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data;
    }

    function canAccessClinic(managerId, clinicId) {
      let profile = currentProfile();
      return isAuthenticated() && (
        request.auth.uid == managerId ||
        (profile.get('managerId', '') == managerId && clinicId != '' && (
          profile.get('clinicId', '') == clinicId ||
          clinicId in profile.get('clinicIds', [])
        ))
      );
    }

    function isReceptionistFor(managerId) {
      return isAuthenticated() &&
        currentProfile().get('role', 'user') == 'receptionist' &&
        currentProfile().get('managerId', '') == managerId;
    }

    function isAssignedProfessional(professionalId) {
      return isAuthenticated() && (
        request.auth.uid == professionalId ||
        currentProfile().get('professionalId', '') == professionalId
      );
    }

    // Is the requester a verified member of the patient's multidisciplinar team?
    // Requires predictable ID: patientId_professionalId
    function isTeamMember(patientId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/patient_teams/$(patientId + "_" + request.auth.uid));
    }

    function canAccessPatient(patientId) {
      let patient = get(/databases/$(database)/documents/patients/$(patientId)).data;
      return isAuthenticated() && (
        (isClinicManager() && request.auth.uid == patient.managerId) ||
        isAssignedProfessional(patient.professionalId) ||
        isTeamMember(patientId)
      );
    }

    // =============================================
    // MASTER ADMIN (Full access for system owner)
    // =============================================
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // =============================================
    // USER PROFILES
    // =============================================
    match /user_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isMasterAdmin() ||
        (isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'isClinicManager', 'managerId', 'permissions'])) ||
        (isClinicManager() &&
          resource.data.managerId == request.auth.uid &&
          request.resource.data.managerId == request.auth.uid);
      allow delete: if isMasterAdmin() ||
        (isClinicManager() && resource.data.managerId == request.auth.uid);
    }

    // =============================================
    // SYSTEM USERS (Authenticated only)
    // =============================================
    match /system_users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        request.auth.uid == resource.data.managerId ||
        get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.managerId == resource.data.managerId ||
        isMasterAdmin()
      );
      allow create: if isMasterAdmin() ||
        (isClinicManager() &&
          request.resource.data.managerId == request.auth.uid &&
          request.resource.data.isClinicManager == false &&
          request.resource.data.role in ['health_professional', 'professional', 'receptionist', 'biller', 'user', 'autonomous_provider']);
      allow update: if isMasterAdmin() ||
        (isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'isClinicManager', 'managerId', 'permissions', 'status'])) ||
        (isClinicManager() &&
          resource.data.managerId == request.auth.uid &&
          request.resource.data.managerId == request.auth.uid &&
          request.resource.data.isClinicManager == resource.data.isClinicManager);
      allow delete: if isMasterAdmin() ||
        (isClinicManager() && resource.data.managerId == request.auth.uid);
    }

    // =============================================
    // PUBLIC PLAN PRICING (master-managed)
    // =============================================
    match /public_config/subscription_plans {
      allow read: if true;
      allow create, update: if isMasterAdmin() &&
        request.resource.data.keys().hasOnly([
          'silver', 'gold', 'enterprise', 'updatedBy', 'updatedAt'
        ]) &&
        request.resource.data.silver is number &&
        request.resource.data.gold is number &&
        request.resource.data.enterprise is number &&
        request.resource.data.silver >= 1 &&
        request.resource.data.gold >= 1 &&
        request.resource.data.enterprise >= 1;
      allow delete: if false;
    }

    // =============================================
    // BILLING (written only by trusted Cloud Functions)
    // =============================================
    match /billing_subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isMasterAdmin()
      );
      allow write: if false;
    }

    // =============================================
    // PATIENTS (Sensitive PHI - Clinic-scoped)
    // =============================================
    match /patients/{patientId} {
      // Use resource fields directly for list queries. Calling get() for the
      // document being listed prevents Firestore from proving the query is safe.
      allow read: if isAuthenticated() && (
        canAccessClinic(resource.data.managerId, resource.data.get('clinicId', '')) ||
        isTeamMember(patientId)
      );
      allow update: if isAuthenticated() && (
        (isClinicManager() && request.auth.uid == resource.data.managerId) ||
        isReceptionistFor(resource.data.managerId) ||
        isAssignedProfessional(resource.data.professionalId) ||
        isTeamMember(patientId)
      );
      allow delete: if isAuthenticated() && (
        (isClinicManager() && request.auth.uid == resource.data.managerId) ||
        isMasterAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.professionalId == request.auth.uid &&
        canAccessClinic(request.resource.data.managerId, request.resource.data.get('clinicId', ''));
    }

    // Mixed anamnesis (subcollection under patients)
    match /patients/{patientId}/mixed_anamnesis/{docId} {
      allow read, write: if canAccessPatient(patientId);
    }

    // =============================================
    // CLINICAL DATA (EMR - PHI, auth required)
    // =============================================
    match /clinical_notes/{noteId} {
      allow read, update, delete: if canAccessPatient(resource.data.patientId);
      allow create: if canAccessPatient(request.resource.data.patientId);
    }

    match /prescriptions/{prescriptionId} {
      allow read, update, delete: if canAccessPatient(resource.data.patientId);
      allow create: if canAccessPatient(request.resource.data.patientId);
    }

    match /exam_requests/{requestId} {
      allow read, update, delete: if canAccessPatient(resource.data.patientId);
      allow create: if canAccessPatient(request.resource.data.patientId);
    }

    match /patient_evolutions/{evolutionId} {
      allow read, update, delete: if canAccessPatient(resource.data.patientId);
      allow create: if canAccessPatient(request.resource.data.patientId);
    }

    match /anamneses/{anamnesisId} {
      allow read, update, delete: if canAccessPatient(resource.data.patientId);
      allow create: if canAccessPatient(request.resource.data.patientId);
    }

    // =============================================
    // TEAM MANAGEMENT
    // =============================================
    match /patient_teams/{teamId} {
      allow read: if isAuthenticated() && (
        resource.data.professionalId == request.auth.uid || 
        resource.data.managerId == request.auth.uid ||
        isMasterAdmin()
      );
      allow write: if isAuthenticated() && (
        request.resource.data.managerId == request.auth.uid ||
        resource.data.managerId == request.auth.uid ||
        isMasterAdmin()
      );
    }

    match /team_invitations/{invitationId} {
      allow read, write: if isAuthenticated();
    }

    // =============================================
    // USER DATA (Core user document and subcollections)
    // =============================================
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isMasterAdmin();
      
      // Subcollections under users/{userId}
      match /appointments/{appointmentId} {
        allow read: if isOwner(userId) ||
          (isClinicManager() && request.auth.uid == resource.data.managerId) ||
          isReceptionistFor(resource.data.managerId) ||
          isAssignedProfessional(resource.data.professionalId);
        allow create: if (isAuthenticated() && (
          (isClinicManager() && request.auth.uid == request.resource.data.managerId) ||
          isReceptionistFor(request.resource.data.managerId) ||
          isAssignedProfessional(request.resource.data.professionalId)
        )) ||
          request.resource.data.bookedOnline == true;
        allow update, delete: if isOwner(userId) ||
          (isClinicManager() && request.auth.uid == resource.data.managerId) ||
          isReceptionistFor(resource.data.managerId) ||
          isAssignedProfessional(resource.data.professionalId);
      }
      
      match /settings/booking {
        allow read: if true;
        allow write: if isOwner(userId);
      }
      
      match /settings/clinicHours {
        allow read: if true;
        allow write: if isOwner(userId);
      }
      
      match /settings/{document} {
        allow read: if isOwner(userId) || isClinicMember(userId);
        allow write: if isOwner(userId);
      }

      match /erp_settings/{document} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }
      
      match /company_data/{docId} {
        allow read, write: if isOwner(userId);
      }
      
      match /simulations/{docId} {
        allow read, write: if isOwner(userId);
      }
      
      match /calculators/{docId} {
        allow read, write: if isOwner(userId);
      }
      
      match /financial_control/{docId} {
        allow read: if isOwner(userId) || isClinicMember(userId);
        allow write: if isOwner(userId) || isClinicMember(userId);
      }
      
      match /sales_management/{docId} {
        allow read, write: if isOwner(userId);
      }
      
      match /medications/{medicationId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }
      
      match /measurements/{measurementId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }
      
      match /clinics/{clinicId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }
      
      match /invoiceRequests/{docId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }
      
      match /accountingDocuments/{docId} {
        allow read: if isAuthenticated() && isClinicMember(userId);
        allow write: if isMasterAdmin();
      }
      
      match /receipts/{docId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }

      match /service_catalog/{docId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }

      match /fiscal_documents/{docId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }

      match /fiscal_counterparties/{docId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }

      match /fiscal_files/{docId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);

        match /chunks/{chunkId} {
          allow read, write: if isAuthenticated() && isClinicMember(userId);
        }
      }

      match /inventory_items/{docId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }

      match /care_packages/{docId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }

      match /asset_items/{docId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }

      match /stock_movements/{docId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }

      match /audit_logs/{docId} {
        allow read, write: if isAuthenticated() && isClinicMember(userId);
      }
    }

    // Collection-group reads need an explicit recursive match. Access remains
    // restricted to the appointment owner or a member of its clinic.
    match /{path=**}/appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        isClinicMember(resource.data.managerId)
      );
    }

    // =============================================
    // HEALTH INSURANCE & TISS DATA
    // =============================================
    match /health_insurances/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /tiss_tables/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /tiss_guides/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /tiss_batches/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /tiss_glosas/{docId} {
      allow read, write: if isAuthenticated();
    }

    // =============================================
    // CONTRACTS & PROFESSIONALS (Semi-public for booking)
    // =============================================
    match /contracts/{contractId} {
      allow read: if isAuthenticated() && (
        resource.data.managerId == request.auth.uid || 
        resource.data.userId == request.auth.uid ||
        isMasterAdmin()
      );
      allow write: if isAuthenticated() && (
        request.resource.data.managerId == request.auth.uid ||
        resource.data.managerId == request.auth.uid ||
        isMasterAdmin()
      );
    }

    match /professionals/{profId} {
      allow read: if true; // Public
      allow write: if isAuthenticated();
    }

    // =============================================
    // FINANCIAL - REPASSE
    // =============================================
    match /repasse_statements/{statementId} {
      allow read: if isAuthenticated() && (
        (isClinicManager() && resource.data.managerId == request.auth.uid) ||
        isAssignedProfessional(resource.data.professionalId) ||
        isMasterAdmin()
      );
      allow write: if isAuthenticated() && (
        (isClinicManager() && request.resource.data.managerId == request.auth.uid) ||
        (isClinicManager() && resource.data.managerId == request.auth.uid) ||
        isMasterAdmin()
      );
    }

    match /consultation_billing/{billingId} {
      allow read: if isAuthenticated() && (
        (isClinicManager() && resource.data.managerId == request.auth.uid) ||
        isAssignedProfessional(resource.data.professionalId) ||
        isMasterAdmin()
      );
      allow create: if isAuthenticated() && (
        (isClinicManager() && request.resource.data.managerId == request.auth.uid) ||
        isAssignedProfessional(request.resource.data.professionalId) ||
        isMasterAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        (isClinicManager() && resource.data.managerId == request.auth.uid) ||
        isMasterAdmin()
      );
    }

    // =============================================
    // CLINIC LINK REQUESTS
    // =============================================
    match /clinic_link_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // =============================================
    // LGPD / DATA CONSENT (Authenticated only)
    // =============================================
    match /lgpd_consents/{consentId} {
      allow read, write: if isAuthenticated();
    }

    // =============================================
    // THERAPEUTIC INTELLIGENCE (Shared Knowledge Base)
    // =============================================
    match /therapeutic_resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // =============================================
    // CATCH-ALL: Deny everything else by default
    // =============================================
  }
}
